# Copy to app/.env (git-ignored) or export these in your shell.

# TypeSafe Jev API key (required)
API_KEY_JEV=

# Jev endpoint and model (defaults shown)
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-latest

# Local OpenAI-compatible LLM server, e.g. LM Studio (defaults shown)
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=google/gemma-4-e4b
# "none" disables Gemma's thinking for speed; "default" omits the field
# LLM_REASONING_EFFORT=none

# Completion cap incl. reasoning tokens (64-32768); bounds runaway generation
# LLM_MAX_TOKENS=1024

# Per-request timeout in seconds (1-600)
# HTTP_TIMEOUT_SECS=120

# Log level
# RUST_LOG=moe_jav=info
